# =============================================================================
# Hello Darzi — Environment Configuration (local / desktop)
# =============================================================================
# Copy this file to .env and fill in values for your environment.
# Business data is stored in local SQLite first (source of truth).
# Supabase is used for Auth, optional cloud backup/sync, and Storage.
# =============================================================================

# --- Supabase (required for sign-in + cloud backup) --------------------------
# Project Settings → API
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Optional aliases used by the local server (mirrors VITE_* when omitted)
# SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
# SUPABASE_ANON_KEY="your-anon-key"

# Optional: Project Settings → JWT Keys → Legacy JWT Secret (HS256 only).
# Newer Supabase projects sign with ES256; the local server fetches JWKS from
# your project URL and caches it for offline verification. Keep the legacy
# secret only if your project still issues HS256 access tokens.
# SUPABASE_JWT_SECRET="your-jwt-secret"

# Apply cloud sync schema once per project:
#   supabase/migrations/20260731000000_cloud_sync.sql
# (SQL Editor or `supabase db push`)

# Optional: force Electron/local data directory when running outside Electron.
# ELECTRON_USER_DATA="C:/path/to/Hello Darzi Dev"

# Optional: mark the process as the desktop local runtime.
# ELECTRON_RUN="true"

# Optional: GitHub token for marketing-site release download button (Vercel).
# GITHUB_TOKEN="ghp_your-token"
