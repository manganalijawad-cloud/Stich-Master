# =============================================================================
# Hello Darzi — Environment Configuration
# =============================================================================
# This file documents all environment variables used by each platform.
# Copy this file to .env and fill in your values.
# =============================================================================
#
# SHARED ENVIRONMENT VARIABLES (used by all platforms)
# -----------------------------------------------------------------------------
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# WEB APPLICATION (apps/web)
# -----------------------------------------------------------------------------
# These are prefixed with VITE_ so Vite exposes them to the browser.
# They must match the SUPABASE_URL and SUPABASE_ANON_KEY above.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# DESKTOP APPLICATION (apps/desktop)
# -----------------------------------------------------------------------------
# Set to "true" when running in Electron with local SQLite database.
# The server will use SQLite for local storage with sync to Supabase.
# ELECTRON_RUN="true"

# SERVER (packages/server)
# -----------------------------------------------------------------------------
# The server uses SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY
# from the shared variables above. No additional configuration needed.
