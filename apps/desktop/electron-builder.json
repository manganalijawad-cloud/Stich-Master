{
  "appId": "com.hellodarzi.app",
  "productName": "Hello Darzi",
  "electronVersion": "43.1.1",
  "directories": {
    "output": "../../release"
  },
  "files": [
    "../../dist/**/*",
    "electron/**/*"
  ],
  "asarUnpack": [
    "../../dist/**"
  ],
  "extraResources": [
    {
      "from": "../../config",
      "to": "config",
      "filter": ["**/*"]
    }
  ],
  "win": {
    "icon": "../../public/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Hello Darzi",
    "runAfterFinish": true
  },
  "publish": {
    "provider": "github",
    "owner": "manganalijawad-cloud",
    "repo": "Stich-Master",
    "releaseType": "release"
  }
}
