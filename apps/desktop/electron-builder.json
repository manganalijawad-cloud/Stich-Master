{
  "appId": "com.hellodarzi.app",
  "productName": "Hello Darzi",
  "electronVersion": "43.1.1",
  "directories": {
    "output": "../../out/desktop"
  },
  "files": [
    "electron/**/*"
  ],
  "asarUnpack": [
    "**/node_modules/better-sqlite3/**/*",
    "**/node_modules/bindings/**/*",
    "**/node_modules/file-uri-to-path/**/*"
  ],
  "extraResources": [
    {
      "from": "../../dist",
      "to": "dist",
      "filter": ["**/*"]
    },
    {
      "from": "../../config/desktop.env",
      "to": ".env"
    },
    {
      "from": "../../node_modules/bindings",
      "to": "dist/node_modules/bindings",
      "filter": ["**/*"]
    },
    {
      "from": "../../node_modules/file-uri-to-path",
      "to": "dist/node_modules/file-uri-to-path",
      "filter": ["**/*"]
    }
  ],
  "win": {
    "icon": "ui/public/icon.ico",
    "artifactName": "Hello-Darzi-Setup-${version}.${ext}",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "protocols": {
    "name": "Hello Darzi",
    "schemes": ["hellodarzi"]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Hello Darzi",
    "runAfterFinish": true
  },
  "publish": {
    "provider": "github",
    "owner": "manganalijawad-cloud",
    "repo": "Stich-Master",
    "releaseType": "release"
  }
}
