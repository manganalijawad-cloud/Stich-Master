{
  "name": "@hello-darzi/website",
  "version": "1.0.4",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "node ../../scripts/sync-release.mjs",
    "css": "tailwindcss -i ./src/input.css -o ./styles.css --minify",
    "predev": "node ../../scripts/sync-release.mjs && npm run css",
    "dev": "node ../../scripts/dev-website.mjs",
    "build": "npm run css && node build.mjs",
    "prestart": "node ../../scripts/sync-release.mjs",
    "start": "node ../../scripts/dev-website.mjs"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.17"
  }
}
