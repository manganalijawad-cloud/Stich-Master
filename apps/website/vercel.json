{
  "version": 2,
  "buildCommand": "node build.mjs",
  "outputDirectory": ".",
  "framework": null,
  "installCommand": "echo 'no install needed'",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml" }
      ]
    },
    {
      "source": "/release/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, must-revalidate" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/login",
      "destination": "/auth.html",
      "permanent": true
    },
    {
      "source": "/signin",
      "destination": "/auth.html",
      "permanent": true
    },
    {
      "source": "/signup",
      "destination": "/auth.html?action=signup",
      "permanent": true
    },
    {
      "source": "/forgot-password",
      "destination": "/auth.html?action=forgot",
      "permanent": true
    },
    {
      "source": "/download",
      "destination": "/#download",
      "permanent": true
    },
    {
      "source": "/github",
      "destination": "https://github.com/manganalijawad-cloud/Stich-Master",
      "permanent": true
    }
  ]
}
