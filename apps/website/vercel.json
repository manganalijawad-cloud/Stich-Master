{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "framework": null,
  "installCommand": "npm install",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/styles.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml" }
      ]
    },
    {
      "source": "/release/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, must-revalidate" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/login",
      "destination": "/auth.html",
      "permanent": true
    },
    {
      "source": "/signin",
      "destination": "/auth.html",
      "permanent": true
    },
    {
      "source": "/signup",
      "destination": "/auth.html?action=signup",
      "permanent": true
    },
    {
      "source": "/forgot-password",
      "destination": "/auth.html?action=forgot",
      "permanent": true
    },
    {
      "source": "/download",
      "destination": "/#download",
      "permanent": true
    },
    {
      "source": "/github",
      "destination": "https://github.com/manganalijawad-cloud/Stich-Master",
      "permanent": true
    }
  ]
}
