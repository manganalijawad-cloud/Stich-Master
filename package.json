{
  "name": "hello-darzi",
  "private": true,
  "version": "1.0.4",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "apps/desktop/server"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/manganalijawad-cloud/Stich-Master.git"
  },
  "scripts": {
    "dev": "npm run dev:server",
    "dev:server": "tsx server.ts",
    "dev:desktop": "concurrently -k \"node scripts/dev-server-electron.mjs\" \"node scripts/wait-and-start-desktop.mjs\"",
    "dev:website": "npm run dev -w @hello-darzi/website",
    "start:desktop": "electron apps/desktop/electron/main.cjs",
    "build:ui": "vite build --config apps/desktop/ui/vite.config.ts",
    "build:server": "esbuild apps/desktop/server/src/index.ts --bundle --platform=node --format=cjs --sourcemap --outfile=dist/server.cjs --external:better-sqlite3 --external:vite --banner:js=\"var import_meta_url=require('url').pathToFileURL(__filename).href;\" --define:import.meta.url=import_meta_url",
    "build": "npm run build:ui",
    "build:all": "npm run build:ui && npm run build:server",
    "start": "node dist/server.cjs",
    "electron:rebuild-native": "cd apps/desktop && npx @electron/rebuild -f -w better-sqlite3 -v 43.1.1",
    "electron:build": "node scripts/prepare-desktop-env.cjs && npm run build:all && npm run electron:rebuild-native && cd apps/desktop && npx electron-builder --win --x64 --config electron-builder.json",
    "clean": "node -e \"const fs=require('fs');['dist','release','out'].forEach(p=>{try{fs.rmSync(p,{recursive:true,force:true})}catch{}})\"",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "concurrently": "^10.0.3",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "esbuild": "^0.25.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.3",
    "wait-on": "^9.0.10"
  }
}
